# Copia este archivo como backend/.env y completa los valores solo en tu máquina.
# No subas backend/.env a GitHub. Este ejemplo no contiene credenciales reales.

# Entorno local: MongoDB Community Server
MONGODB_URI=mongodb://127.0.0.1:27017/nova_salud

# Producción: usa la misma variable con la cadena de MongoDB Atlas.
# MONGODB_URI=mongodb+srv://USUARIO:CONTRASENA@cluster.ejemplo.mongodb.net/nova_salud

PORT=3000
JWT_SECRET=
